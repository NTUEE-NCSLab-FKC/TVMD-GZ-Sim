<launch>
  <!--
    播放 ULog/RosBag 檔案並在 RViz 中顯示

    使用方式:
      1. 先轉換 ULog 為 RosBag:
         cd tools && ./ulog2bag.sh -f /path/to/your_log.ulg

      2. 播放:
         roslaunch tvmd playback.launch bag:=/path/to/your_log.bag

    參數:
      - bag: RosBag 檔案路徑 (必填)
      - rate: 播放速率 (預設 1.0)
      - start: 開始時間偏移 (預設 0)
      - loop: 是否循環播放 (預設 false)
  -->

  <!-- 參數 -->
  <arg name="model" default="$(find tvmd)/urdf/tvmd.xacro"/>
  <arg name="rvizconfig" default="$(find tvmd)/launch/urdf.rviz"/>
  <arg name="bag" />
  <arg name="rate" default="1.0"/>
  <arg name="start" default="0"/>
  <arg name="loop" default="false"/>

  <!-- 載入機器人描述 -->
  <param name="robot_description" command="$(find xacro)/xacro $(arg model)"/>

  <!-- Joint State Republisher (將 PX4 topics 轉換為 joint states 和 markers) -->
  <node name="joint_state_republisher" pkg="tvmd" type="republisher.py" output="screen"/>

  <!-- Robot State Publisher -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- RViz -->
  <node name="rviz" pkg="rviz" args="-d $(arg rvizconfig)" type="rviz" required="true"/>

  <!-- RosBag 播放 -->
  <node name="rosbag_play" pkg="rosbag" type="play" output="screen"
        args="$(arg bag) --rate $(arg rate) --start $(arg start) --clock $(eval '--loop' if arg('loop') else '')">
    <remap from="control_allocation_meta_data" to="px4/control_allocation_meta_data"/>
    <remap from="actuator_motors" to="px4/actuator_motors"/>
    <remap from="actuator_servos" to="px4/actuator_servos"/>
    <remap from="vehicle_thrust_setpoint" to="px4/vehicle_thrust_setpoint"/>
    <remap from="vehicle_torque_setpoint" to="px4/vehicle_torque_setpoint"/>
    <remap from="vehicle_attitude" to="px4/vehicle_attitude"/>
  </node>

</launch>
