<launch>
  <arg name="model" default="$(find tvmd)/urdf/tvmd.xacro"/>
  <arg name="gui" default="true"/>
  <arg name="rvizconfig" default="$(find tvmd)/launch/urdf.rviz"/>
  <param name="robot_description" command="$(find xacro)/xacro $(arg model)"/>
  <param name="use_gui" value="$(arg gui)"/>
  <!-- <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui"/> -->
  <arg name="rate" default="50"/>
  <arg name="force_filter_tau" default="0.05"/>
  <arg name="servo_filter_tau" default="0.03"/>
  <arg name="servo_mapping" default="px4"/>
  <arg name="force_origin_z" default="0.017"/>
  <arg name="thrust_color_mode" default="gradient"/>
  <arg name="thrust_head_offset" default="0.0"/>
  <node name="joint_state_republisher" pkg="tvmd" type="republisher.py" output="screen">
    <!-- Rate of republishing joint states, TF, and markers to Rviz [Hz] -->
    <param name="rate" value="$(arg rate)"/>
    <!-- Rate of publishing the trajectory (nav_msgs/Path) [Hz] -->
    <param name="path_rate" value="10"/>
    <param name="path_max_length" value="5000"/>
    <!-- Low-pass filter time constants for smoother visualization [s], 0 to disable -->
    <param name="force_filter_tau" value="$(arg force_filter_tau)"/>
    <param name="servo_filter_tau" value="$(arg servo_filter_tau)"/>
    <!-- actuator_servos.control -> joint angle: px4 (CA_SV_TLx_MINA/MAXA, gear ratio), rad (as GZ-Sim), urdf (legacy) -->
    <param name="servo_mapping" value="$(arg servo_mapping)"/>
    <param name="servo_min_deg" value="-30"/>
    <param name="servo_max_deg" value="30"/>
    <param name="servo_gear_ratio" value="1.0"/>
    <!-- Starting point of the thrust vectors: height of the propeller center above the gimbal pivot [m] -->
    <param name="force_origin_z" value="$(arg force_origin_z)"/>
    <!-- Motor model for the thrust arrows: thrust = c_l * u + Tf0 (ActuatorEffectivenessVTOL_TVMD.hpp) -->
    <param name="thrust_cl" value="6.125"/>
    <param name="thrust_tf0" value="0.0"/>
    <!-- Color of the thrust arrows: gradient (as the pseudo-forces), magnitude (blue: 0, red: full throttle) or module -->
    <param name="thrust_color_mode" value="$(arg thrust_color_mode)"/>
    <!-- Arrow heads of the thrusts: offset from the end of the line, length and diameter [m] -->
    <param name="thrust_head_offset" value="$(arg thrust_head_offset)"/>
    <param name="thrust_head_length" value="0.03"/>
    <param name="thrust_head_diameter" value="0.025"/>
  </node>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
    <!-- Do not throttle joint_states, otherwise the module TFs may fall behind base_link -->
    <param name="ignore_timestamp" value="true"/>
  </node>
  <node name="rviz" pkg="rviz" args="-d $(arg rvizconfig)" type="rviz" required="true"/>
</launch>
