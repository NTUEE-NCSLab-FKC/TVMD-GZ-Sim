<?xml version="1.0" ?>
<robot name="tvmd" xmlns:xacro="http://www.ros.org/wiki/xacro" >

  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>

  <material name="aluminum">
    <color rgba="0.800 0.800 0.820 1.000"/>  
  </material>

  <material name="dark_metal">
    <color rgba="0.300 0.300 0.320 1.000"/>
  </material>

  <material name="gold">
    <color rgba="0.830 0.680 0.210 1.000"/>
  </material>

  <material name="copper">
    <color rgba="0.720 0.450 0.200 1.000"/>
  </material>

  <material name="carbon_fiber">
    <color rgba="0.150 0.150 0.150 1.000"/>
  </material>

  <material name="titanium_blue">
    <color rgba="0.300 0.350 0.500 1.000"/>
  </material>

  <material name="titanium_purple">
    <color rgba="0.450 0.350 0.500 1.000"/>
  </material>

  <material name="titanium_rainbow">
    <color rgba="0.500 0.400 0.450 1.000"/>
  </material>

  <material name="red">
    <color rgba="0.800 0.200 0.200 1.000"/>
  </material>

  <material name="orange">
    <color rgba="1.000 0.500 0.000 1.000"/>
  </material>

  <material name="yellow">
    <color rgba="1.000 1.000 0.000 1.000"/>
  </material>

  <material name="green">
    <color rgba="0.200 0.800 0.200 1.000"/>
  </material>

  <material name="blue">
    <color rgba="0.200 0.200 0.800 1.000"/>
  </material>

  <material name="black">
    <color rgba="0.000 0.000 0.000 1.000"/>
  </material>

  <material name="gray">
    <color rgba="0.200 0.200 0.200 1.000"/>
  </material>

  <material name="dark_blue">
    <color rgba="0.100 0.100 0.300 1.000"/>  
  </material>

</robot>
